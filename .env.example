DB_HOST=localhost
DB_USER=UTILIZATOR
DB_PASSWORD=PAROLA
DB_NAME=fructulb_shop
AUTH_SECRET=schimba-cu-o-valoare-lunga-si-aleatorie

# Lasa gol daca backend-ul este servit pe acelasi domeniu si path /api.
# Exemplu pentru subdomeniu: https://api.fructulbucovinei.ro
NEXT_PUBLIC_API_BASE_URL=

# NETOPIA Payments (legacy XML/RSA sandbox flow)
# The private key must never be committed to the repository.
NETOPIA_ENVIRONMENT=sandbox
NETOPIA_POS_SIGNATURE=XXXX-XXXX-XXXX-XXXX-XXXX
NETOPIA_PRIVATE_KEY_PATH=C:/secure/netopia/sandbox-private.key
NETOPIA_PUBLIC_CERT_PATH=C:/secure/netopia/sandbox-public.cer
# For deployment, you can use NETOPIA_PRIVATE_KEY_BASE64 and
# NETOPIA_PUBLIC_CERT_BASE64 instead of filesystem paths.
NETOPIA_CONFIRM_URL=https://api.example.com/api/payments/netopia/confirm

# Activeaza pagina publica "coming soon" cat timp lucrezi.
# Tu poti vedea site-ul complet cu /?preview=CHEIA_TA.
NEXT_PUBLIC_SITE_LOCKED=false
NEXT_PUBLIC_SITE_PREVIEW_KEY=schimba-cu-o-cheie-preview
