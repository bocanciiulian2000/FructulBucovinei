NODE_ENV=production
PORT=3001

DB_HOST=localhost
DB_USER=UTILIZATOR
DB_PASSWORD=PAROLA
DB_NAME=fructulb_shop

AUTH_SECRET=schimba-cu-o-valoare-lunga-si-aleatorie

# Pentru backend pe subdomeniu, ex: https://api.fructulbucovinei.ro
# Pentru backend pe acelasi domeniu si path /api, lasa gol sau pune domeniul principal.
FRONTEND_ORIGIN=https://fructulbucovinei.ro
# Optional, daca folosesti si varianta cu www.
FRONTEND_ORIGINS=https://fructulbucovinei.ro,https://www.fructulbucovinei.ro

# Optional, util daca backend-ul ruleaza pe api.fructulbucovinei.ro si vrei cookie comun.
# Exemplu: .fructulbucovinei.ro
COOKIE_DOMAIN=
